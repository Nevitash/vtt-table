{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-and-start",
            "type": "shell",
            "command": "npm run dev",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Local:",
                    "endsPattern": "Local:"
                }
            }
        }
    ]
}